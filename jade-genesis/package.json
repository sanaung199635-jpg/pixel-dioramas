{
  "name": "jade-genesis",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "JADE GENESIS · 翡翠诞生记 — interactive 3D journey from rough jadeite to bangle",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "knowledge": "node tools/build-knowledge.cjs",
    "test": "playwright test",
    "release": "tsc --noEmit && vite build --outDir play --emptyOutDir"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.21",
    "@types/three": "0.170.0",
    "typescript": "5.7.3",
    "vite": "6.3.5"
  }
}
